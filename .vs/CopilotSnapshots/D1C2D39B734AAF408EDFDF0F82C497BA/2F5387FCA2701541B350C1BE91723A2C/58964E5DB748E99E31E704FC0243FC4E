using System;
using System.Configuration;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Threading.Tasks;
using System.Windows.Forms;
using System.Data.SQLite;

namespace Project_2_Warehouse
{
    internal static class Program
    {
        [STAThread]
        static void Main()
        {
            // Remove an empty database left by a failed first start.
            var dataDirectory = AppDomain.CurrentDomain.GetData("DataDirectory") as string ?? AppDomain.CurrentDomain.BaseDirectory;
            var databasePath = Path.Combine(dataDirectory, "warehouse.sqlite");
            if (File.Exists(databasePath) && new FileInfo(databasePath).Length == 0) File.Delete(databasePath);
            InitializeDatabase(dataDirectory);

            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);
            Application.Run(new Form1());
        }

        private static void InitializeDatabase(string dataDirectory)
        {
            // Create the database tables before the forms start loading data.
            var connectionString = ConfigurationManager.ConnectionStrings["WarehouseContext"].ConnectionString.Replace("|DataDirectory|", dataDirectory);
            using (var connection = new SQLiteConnection(connectionString))
            {
                connection.Open();
                MigrateLegacySchema(connection);
                using (var command = connection.CreateCommand())
                {
                    command.CommandText = @"
CREATE TABLE IF NOT EXISTS ProductCategories (Id INTEGER PRIMARY KEY AUTOINCREMENT, Name TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS Products (Id INTEGER PRIMARY KEY AUTOINCREMENT, Name TEXT NOT NULL, Description TEXT, EntryDate DATETIME NOT NULL, ExpirationDate DATETIME NOT NULL, Quantity INTEGER NOT NULL, CategoryId INTEGER NOT NULL, FOREIGN KEY (CategoryId) REFERENCES ProductCategories(Id));
CREATE TABLE IF NOT EXISTS SalesHistories (Id INTEGER PRIMARY KEY AUTOINCREMENT, ProductId INTEGER NOT NULL, Quantity INTEGER NOT NULL, SaleDate DATETIME NOT NULL);";
                    command.ExecuteNonQuery();
                }
            }
        }

        private static void MigrateLegacySchema(SQLiteConnection connection)
        {
            RenameTableAndColumns(connection, "CategorieProdus", "ProductCategories", new[] { "Denumire", "Name" });
            RenameTableAndColumns(connection, "Produs", "Products", new[] { "Denumire", "Name", "Descriere", "Description", "DataIntrare", "EntryDate", "DataExpirare", "ExpirationDate", "Cantitate", "Quantity", "IdCategorie", "CategoryId" });
            RenameTableAndColumns(connection, "IstoricVanzari", "SalesHistories", new[] { "IdProdus", "ProductId", "Cantitate", "Quantity", "DataVanzare", "SaleDate" });
        }

        private static void RenameTableAndColumns(SQLiteConnection connection, string oldTable, string newTable, string[] columnPairs)
        {
            if (!TableExists(connection, oldTable) || TableExists(connection, newTable)) return;
            Execute(connection, string.Format("ALTER TABLE [{0}] RENAME TO [{1}]", oldTable, newTable));
            for (var i = 0; i < columnPairs.Length; i += 2)
            {
                Execute(connection, string.Format("ALTER TABLE [{0}] RENAME COLUMN [{1}] TO [{2}]", newTable, columnPairs[i], columnPairs[i + 1]));
            }
        }

        private static bool TableExists(SQLiteConnection connection, string tableName)
        {
            using (var command = connection.CreateCommand())
            {
                command.CommandText = "SELECT COUNT(*) FROM sqlite_master WHERE type = 'table' AND name = @name";
                command.Parameters.AddWithValue("@name", tableName);
                return Convert.ToInt32(command.ExecuteScalar()) > 0;
            }
        }

        private static void Execute(SQLiteConnection connection, string sql)
        {
            using (var command = connection.CreateCommand())
            {
                command.CommandText = sql;
                command.ExecuteNonQuery();
            }
        }
    }
}
